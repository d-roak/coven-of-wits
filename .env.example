# Server only. Never use a VITE_ prefix for the token.
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_TOKEN=
# Public origin, e.g. https://your-site.example. Set behind a reverse proxy.
PUBLIC_ORIGIN=
# Durable volume for delivery receipts. Stores hashes and issue URLs, not report bodies.
FEEDBACK_DATA_DIR=
# Optional public build label included in diagnostics.
VITE_APP_VERSION=
